<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example</groupId>
    <artifactId>shared-starter</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shared-lock-starter</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-lock</artifactId>
    </dependency>

    <dependency>
      <!-- lock4j：编程式 LockTemplate + 声明式 @Lock4j；RedisTemplate executor 走 Lettuce 统一通道。
           无 Redis 宿主由 lock4j 自动配置条件与本地锁兜底共同处理 -->
      <groupId>com.baomidou</groupId>
      <artifactId>lock4j-redis-template-spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example</groupId>
    <artifactId>business-core-kernel</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>business-core-adapter</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>file-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>business-core-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>business-core-application</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- SessionContextResolver 依赖 HttpServletRequest(运行时由嵌入式 Tomcat 提供) -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- 功能权限校验: 提供 @RequirePermission 注解 + AOP 切面自动装配 -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-permission-starter</artifactId>
    </dependency>

    <!-- spec §14：kernel 显式接入 shared 能力，不依赖宿主偶然提供 -->
    <!-- 通用 API / 统一异常 / 链路追踪（MDC） -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-web-starter</artifactId>
    </dependency>
    <!-- 不可变流程定义与只读规则缓存（生产可切 L2/MULTI，示例服务降级 L1_ONLY） -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-cache-starter</artifactId>
    </dependency>
    <!-- 步骤耗时 / HTTP 日志 / 脱敏 / MDC 管道 -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-logging-starter</artifactId>
    </dependency>

    <!-- 测试依赖:JUnit5 + AssertJ + Spring Test(MockHttpServletRequest) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>

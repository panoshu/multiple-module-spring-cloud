<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- V-05：统一输出链路 MDC。traceId 由 shared-web-starter 的
       BizContextPropagationFilter 生成/透传；applicationId / stepExecutionId /
       requestNo / businessType 由 business-core-kernel 的 FlowOrchestrationService
       在流程推进期间写入。 -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <property name="MDC_CONTEXT_FIELDS"
            value="[traceId:%X{traceId:-}][applicationId:%X{applicationId:-}][stepExecutionId:%X{stepExecutionId:-}][requestNo:%X{requestNo:-}][businessType:%X{businessType:-}]"/>

  <!-- fat jar 的 Tomcat/JULI 桥接线程上，%wEx 的 packaging data 计算偶尔
       触发 NoClassDefFoundError(ClassPackagingData)，连带吞掉真实异常并挂起请求。
       %rEx 输出完整堆栈但不计算 packaging data。 -->
  <property name="LOG_EXCEPTION_CONVERSION_WORD" value="%rEx"/>

  <property name="CONSOLE_LOG_PATTERN"
            value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:-}){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %clr(${MDC_CONTEXT_FIELDS}){yellow} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
  <property name="FILE_LOG_PATTERN"
            value="%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}} ${LOG_LEVEL_PATTERN:-%5p} ${PID:-} --- [%t] %-40.40logger{39} : ${MDC_CONTEXT_FIELDS} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

  <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>

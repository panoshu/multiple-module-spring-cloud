<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example</groupId>
    <artifactId>annuity-service</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>annuity-starter</artifactId>
  <description>年金服务 - 启动模块（启动类、打包入口）</description>
  <properties>
    <!-- 覆盖父 pom 的 spring-boot.run.skip=true：本启动模块需产出可执行 fat jar（java -jar） -->
    <spring-boot.run.skip>false</spring-boot.run.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>annuity-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>annuity-infrastructure</artifactId>
    </dependency>
    <!-- kernel 宿主入口：统一装配 kernel 组件、mapper 与异步能力；
         宿主启动类不再扫描 com.example.core / kernel mapper 包 -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>business-core-starter</artifactId>
    </dependency>

    <!-- Web 服务基础设施：内嵌容器、自动配置、注册中心等 -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-web-starter</artifactId>
    </dependency>
    <!-- S-03：注册中心从 shared-web-starter 拆出，需要 Nacos 注册的服务显式引入 -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-discovery-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- 主配置 spring.http.client.factory=http-components 运行时需要 httpclient5；
           原 test scope 仅满足 E2E，真实启动会 NoClassDefFoundError（批次 72 修复） -->
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- 数据源驱动（测试用 H2 无需驱动；真实启动必需，版本由 Spring Boot BOM 管理） -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>annuity-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

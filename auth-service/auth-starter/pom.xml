<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example</groupId>
    <artifactId>auth-service</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>auth-starter</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>auth-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>auth-infrastructure</artifactId>
    </dependency>

    <!-- Web 服务基础设施：内嵌容器、自动配置、注册中心等 -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-web-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>shared-cache-starter</artifactId>
    </dependency>
    <dependency>
      <!-- 数据源驱动（测试用 H2 无需驱动；真实启动必需，版本由 Spring Boot BOM 管理） -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>auth-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
